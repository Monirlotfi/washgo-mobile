{
  "expo": {
    "name": "WashGo",
    "slug": "washgo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "washgo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "owner": "loutfihi_mounir",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WashGo a besoin de votre position pour vous proposer un laveur à proximité."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.washgo.mobile",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAkJN68qNptboZqbOMV7JOvdNUEE1aoFOk"
        }
      }
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-maps",
        {
          "android": {
            "googleMapsApiKey": "AIzaSyAkJN68qNptboZqbOMV7JOvdNUEE1aoFOk"
          }
        }
      ],
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "WashGo a besoin de votre position pour vous proposer un laveur à proximité."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2b28d2dd-007f-4dcd-953d-c0545b6a2907"
      },
      "router": {}
    }
  }
}
